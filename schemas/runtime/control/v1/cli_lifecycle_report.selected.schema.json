                  "requests": {
                    "const": 0
                  },
                  "streams": {
                    "const": 0
                  },
                  "slots": {
                    "const": 0
                  },
                  "replacements": {
                    "const": 0
                  },
                  "cleanup_obligations": {
                    "const": 0
                  }
                }
              }
            }
          }
        }
      ],
      "oneOf": [
        {
          "allOf": [
            {
              "properties": {
