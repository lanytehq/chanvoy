        },
        "reason": {
          "enum": [
            "active_obligations",
            "target_mismatch",
            "generation_refused",
            "revision_changed",
            "already_retiring",
            "durable_retiring",
            "publication_unconfirmed",
            "ack_unconfirmed",
            "native_evidence_unavailable"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "origin": {
                "const": "daemon_response"
              }
            }
          },
          "then": {
            "properties": {
              "facts": {
                "properties": {
                  "responding_at_snapshot": {
                    "const": true
                  }
                }
              }
            }
          }
        },
        {
