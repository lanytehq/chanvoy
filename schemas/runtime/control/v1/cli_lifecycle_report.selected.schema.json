{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device",
        "inode"
      ],
      "properties": {
        "device": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "inode": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        }
      }
    },
    "birth": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "clock_ticks"
          ],
          "properties": {
            "kind": {
              "const": "linux"
            },
            "clock_ticks": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "seconds",
            "microseconds"
          ],
          "properties": {
            "kind": {
              "const": "mac_os"
            },
            "seconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "microseconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 999999
            }
          }
        }
      ]
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pid",
        "uid",
        "birth",
        "executable",
        "pid_namespace",
        "mount_namespace"
      ],
      "properties": {
        "pid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "uid": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "birth": {
          "$ref": "#/$defs/birth"
        },
        "executable": {
          "type": "string",
          "minLength": 2,
          "maxLength": 8192,
          "pattern": "^(?:[0-9a-f]{2})+$",
          "description": "Lossless absolute OS path bytes, lowercase hex; native codec also rejects NUL/parent traversal."
        },
        "pid_namespace": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/identity"
            }
          ]
        },
        "mount_namespace": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/identity"
            }
          ]
        }
      }
    },
    "socket": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "identity"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 2,
          "maxLength": 214,
          "pattern": "^(?:[0-9a-f]{2})+$",
          "description": "Lossless absolute OS path bytes, lowercase hex; native codec also rejects NUL/parent traversal."
        },
        "identity": {
          "$ref": "#/$defs/identity"
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "commit",
        "dirty"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "commit": {
          "type": "string",
          "pattern": "^(?:[0-9a-fA-F]{40}|unknown)$"
        },
        "dirty": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "uuid": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "namespace": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "u64": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "u32": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "path_bytes": {
      "type": "string",
      "minLength": 2,
      "maxLength": 8192,
      "pattern": "^(?:[0-9a-f]{2})+$",
      "description": "Lossless absolute OS path bytes, lowercase hex; native codec also rejects NUL/parent traversal."
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "commit",
        "dirty"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "commit": {
          "type": "string",
          "minLength": 40,
          "maxLength": 40,
          "pattern": "^[0-9a-f]{40}$"
        },
        "dirty": {
          "type": "boolean"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "instance_uuid",
        "record_revision",
        "process"
      ],
      "properties": {
        "namespace": {
          "$ref": "#/$defs/namespace"
        },
        "instance_uuid": {
          "$ref": "#/$defs/uuid"
        },
        "record_revision": {
          "$ref": "#/$defs/u64"
        },
        "process": {
          "$ref": "#/$defs/process"
        }
      }
    },
    "retirement_params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "action",
        "target",
        "caller_generation"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "retirement_params"
        },
        "action": {
          "enum": [
            "begin",
            "continue_same_epoch"
          ]
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "caller_generation": {
          "$ref": "#/$defs/generation"
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requests",
        "streams",
        "slots",
        "replacements",
        "cleanup_obligations"
      ],
      "properties": {
        "requests": {
          "oneOf": [
            {
              "$ref": "#/$defs/u64"
            },
            {
              "type": "null"
            }
          ]
        },
        "streams": {
          "oneOf": [
            {
              "$ref": "#/$defs/u64"
            },
            {
              "type": "null"
            }
          ]
        },
        "slots": {
          "oneOf": [
            {
              "$ref": "#/$defs/u64"
            },
            {
              "type": "null"
            }
          ]
        },
        "replacements": {
          "oneOf": [
            {
              "$ref": "#/$defs/u64"
            },
            {
              "type": "null"
            }
          ]
        },
        "cleanup_obligations": {
          "oneOf": [
            {
              "$ref": "#/$defs/u64"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "retirement_facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memory_retiring",
        "durable_retiring",
        "shutdown_started",
        "responding_at_snapshot",
        "admission_closed",
        "durable_revision"
      ],
      "properties": {
        "memory_retiring": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "durable_retiring": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "shutdown_started": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "responding_at_snapshot": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "admission_closed": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "durable_revision": {
          "oneOf": [
            {
              "$ref": "#/$defs/u64"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "memory_retiring": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "admission_closed": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "memory_retiring": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "admission_closed": {
                "const": false
              },
              "durable_retiring": {
                "const": false
              },
              "shutdown_started": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "durable_retiring": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "memory_retiring": {
                "const": true
              },
              "admission_closed": {
                "const": true
              },
              "durable_revision": {
                "$ref": "#/$defs/u64"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "shutdown_started": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "memory_retiring": {
                "const": true
              },
              "durable_retiring": {
                "const": true
              },
              "admission_closed": {
                "const": true
              },
              "durable_revision": {
                "$ref": "#/$defs/u64"
              }
            }
          }
        },
